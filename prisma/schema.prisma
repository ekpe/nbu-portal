generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleCode {
  SUPER_ADMIN
  DEAN
  HOD
  COURSE_ADVISER
  LECTURER
  STUDENT
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  firstName    String
  lastName     String
  middleName   String?
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  roles          UserRole[]
  studentProfile StudentProfile?
  staffProfile   StaffProfile?
  notifications  Notification[]
}

model Role {
  id          String   @id @default(cuid())
  code        RoleCode @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users UserRole[]
}

model UserRole {
  id               String   @id @default(cuid())
  userId           String
  roleId           String
  isActive         Boolean  @default(true)
  assignedAt       DateTime @default(now())
  assignedByUserId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

model AcademicSession {
  id                         String                       @id @default(cuid())
  name                       String                       @unique
  startDate                  DateTime?
  endDate                    DateTime?
  isActive                   Boolean                      @default(true)
  isCurrent                  Boolean                      @default(false)
  createdAt                  DateTime                     @default(now())
  updatedAt                  DateTime                     @updatedAt
  CourseOffering             CourseOffering[]
  AdviserAssignment          AdviserAssignment[]
  StudentProgrammeEnrollment StudentProgrammeEnrollment[]
  CourseRegistration         CourseRegistration[]
  ResultSheet                ResultSheet[]
  GPARecord                  GPARecord[]
  CGPARecord                 CGPARecord[]
  TranscriptLedgerEntry      TranscriptLedgerEntry[]
  StudentFinanceAccount      StudentFinanceAccount[]
  PaymentTransaction         PaymentTransaction[]
  ReceiptLedgerEntry         ReceiptLedgerEntry[]
  InstallmentPlan            InstallmentPlan[]
}

model Semester {
  id                         String                       @id @default(cuid())
  code                       String                       @unique
  name                       String
  startDate                  DateTime?
  endDate                    DateTime?
  isActive                   Boolean                      @default(true)
  isCurrent                  Boolean                      @default(false)
  createdAt                  DateTime                     @default(now())
  updatedAt                  DateTime                     @updatedAt
  CourseOffering             CourseOffering[]
  AdviserAssignment          AdviserAssignment[]
  StudentProgrammeEnrollment StudentProgrammeEnrollment[]
  CourseRegistration         CourseRegistration[]
  ResultSheet                ResultSheet[]
  GPARecord                  GPARecord[]
  CGPARecord                 CGPARecord[]
  TranscriptLedgerEntry      TranscriptLedgerEntry[]
  StudentFinanceAccount      StudentFinanceAccount[]
  PaymentTransaction         PaymentTransaction[]
  ReceiptLedgerEntry         ReceiptLedgerEntry[]
  InstallmentPlan            InstallmentPlan[]
}

model Faculty {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  departments                Department[]
  staffProfiles              StaffProfile[]
  studentProfiles            StudentProfile[]
  programmes                 Programme[]
  Course                     Course[]
  CourseOffering             CourseOffering[]
  AdviserAssignment          AdviserAssignment[]
  StudentProgrammeEnrollment StudentProgrammeEnrollment[]
}

model Department {
  id          String   @id @default(cuid())
  facultyId   String
  code        String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  faculty                    Faculty                      @relation(fields: [facultyId], references: [id], onDelete: Restrict)
  programmes                 Programme[]
  staffProfiles              StaffProfile[]
  studentProfiles            StudentProfile[]
  Course                     Course[]
  CourseOffering             CourseOffering[]
  AdviserAssignment          AdviserAssignment[]
  StudentProgrammeEnrollment StudentProgrammeEnrollment[]

  @@index([facultyId])
}

model Programme {
  id            String   @id @default(cuid())
  departmentId  String
  facultyId     String
  code          String   @unique
  name          String
  awardType     String?
  durationYears Int?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  department                 Department                   @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  faculty                    Faculty                      @relation(fields: [facultyId], references: [id], onDelete: Restrict)
  studentProfiles            StudentProfile[]
  Course                     Course[]
  CourseOffering             CourseOffering[]
  AdviserAssignment          AdviserAssignment[]
  StudentProgrammeEnrollment StudentProgrammeEnrollment[]

  @@index([departmentId])
  @@index([facultyId])
}

model Level {
  id           String   @id @default(cuid())
  code         String   @unique
  name         String
  numericValue Int
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  studentProfiles            StudentProfile[]
  Course                     Course[]
  CourseOffering             CourseOffering[]
  AdviserAssignment          AdviserAssignment[]
  StudentProgrammeEnrollment StudentProgrammeEnrollment[]
}

model StudentProfile {
  id                  String   @id @default(cuid())
  userId              String   @unique
  matricNumber        String   @unique
  admissionNumber     String?  @unique
  admissionYear       Int?
  currentLevelId      String?
  currentProgrammeId  String?
  currentDepartmentId String?
  currentFacultyId    String?
  status              String   @default("ACTIVE")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  level      Level?      @relation(fields: [currentLevelId], references: [id], onDelete: SetNull)
  programme  Programme?  @relation(fields: [currentProgrammeId], references: [id], onDelete: SetNull)
  department Department? @relation(fields: [currentDepartmentId], references: [id], onDelete: SetNull)
  faculty    Faculty?    @relation(fields: [currentFacultyId], references: [id], onDelete: SetNull)

  enrollments             StudentProgrammeEnrollment[]
  registrations           CourseRegistration[]
  resultEntries           ResultEntry[]
  gpaRecords              GPARecord[]
  cgpaRecords             CGPARecord[]
  transcriptLedgerEntries TranscriptLedgerEntry[]

  financeAccount       StudentFinanceAccount?
  paymentTransactions  PaymentTransaction[]
  receiptLedgerEntries ReceiptLedgerEntry[]
  financeHolds         FinanceHold[]
  financeOverrides     FinanceOverrideRequest[]
  installmentPlans     InstallmentPlan[]

  @@index([currentLevelId])
  @@index([currentProgrammeId])
  @@index([currentDepartmentId])
  @@index([currentFacultyId])
}

model StaffProfile {
  id               String   @id @default(cuid())
  userId           String   @unique
  staffNumber      String   @unique
  title            String?
  qualification    String?
  rank             String?
  departmentId     String?
  facultyId        String?
  employmentStatus String   @default("ACTIVE")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  faculty    Faculty?    @relation(fields: [facultyId], references: [id], onDelete: SetNull)

  lecturerAssignments CourseAssignment[]  @relation("LecturerAssignments")
  adviserAssignments  AdviserAssignment[] @relation("AdviserAssignments")
  resultSheets        ResultSheet[]

  @@index([departmentId])
  @@index([facultyId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  summary    String?
  beforeJson Json?
  afterJson  Json?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([entityType])
  @@index([entityId])
  @@index([createdAt])
}

model Course {
  id                  String   @id @default(cuid())
  courseCode          String   @unique
  title               String
  description         String?
  creditUnits         Int
  departmentId        String
  facultyId           String
  programmeId         String?
  levelId             String?
  category            String   @default("CORE")
  isCarryoverEligible Boolean  @default(true)
  isElective          Boolean  @default(false)
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  faculty    Faculty    @relation(fields: [facultyId], references: [id], onDelete: Restrict)
  programme  Programme? @relation(fields: [programmeId], references: [id], onDelete: SetNull)
  level      Level?     @relation(fields: [levelId], references: [id], onDelete: SetNull)

  offerings             CourseOffering[]
  registrationItems     CourseRegistrationItem[]
  TranscriptLedgerEntry TranscriptLedgerEntry[]

  @@index([departmentId])
  @@index([facultyId])
  @@index([programmeId])
  @@index([levelId])
}

model CourseOffering {
  id              String   @id @default(cuid())
  courseId        String
  sessionId       String
  semesterId      String
  facultyId       String
  departmentId    String
  programmeId     String?
  levelId         String?
  registrationCap Int?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  course     Course          @relation(fields: [courseId], references: [id], onDelete: Restrict)
  session    AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  semester   Semester        @relation(fields: [semesterId], references: [id], onDelete: Restrict)
  faculty    Faculty         @relation(fields: [facultyId], references: [id], onDelete: Restrict)
  department Department      @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  programme  Programme?      @relation(fields: [programmeId], references: [id], onDelete: SetNull)
  level      Level?          @relation(fields: [levelId], references: [id], onDelete: SetNull)

  assignments       CourseAssignment[]
  registrationItems CourseRegistrationItem[]
  resultSheets      ResultSheet[]

  @@index([courseId])
  @@index([sessionId])
  @@index([semesterId])
  @@index([facultyId])
  @@index([departmentId])
  @@index([programmeId])
  @@index([levelId])
}

model CourseAssignment {
  id                     String   @id @default(cuid())
  courseOfferingId       String
  lecturerStaffProfileId String
  assignedByUserId       String?
  assignedAt             DateTime @default(now())
  isPrimary              Boolean  @default(true)
  isActive               Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  offering CourseOffering @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)
  lecturer StaffProfile   @relation("LecturerAssignments", fields: [lecturerStaffProfileId], references: [id], onDelete: Restrict)

  @@index([courseOfferingId])
  @@index([lecturerStaffProfileId])
}

model AdviserAssignment {
  id               String   @id @default(cuid())
  staffProfileId   String
  facultyId        String
  departmentId     String?
  programmeId      String?
  levelId          String?
  sessionId        String
  semesterId       String
  isActive         Boolean  @default(true)
  assignedByUserId String?
  assignedAt       DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  staffProfile StaffProfile    @relation("AdviserAssignments", fields: [staffProfileId], references: [id], onDelete: Restrict)
  faculty      Faculty         @relation(fields: [facultyId], references: [id], onDelete: Restrict)
  department   Department?     @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  programme    Programme?      @relation(fields: [programmeId], references: [id], onDelete: SetNull)
  level        Level?          @relation(fields: [levelId], references: [id], onDelete: SetNull)
  session      AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  semester     Semester        @relation(fields: [semesterId], references: [id], onDelete: Restrict)

  @@index([staffProfileId])
  @@index([facultyId])
  @@index([departmentId])
  @@index([programmeId])
  @@index([levelId])
  @@index([sessionId])
  @@index([semesterId])
}

model StudentProgrammeEnrollment {
  id               String   @id @default(cuid())
  studentProfileId String
  programmeId      String
  departmentId     String
  facultyId        String
  levelId          String
  sessionId        String
  semesterId       String
  enrollmentStatus String   @default("ACTIVE")
  isCurrent        Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  studentProfile StudentProfile  @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  programme      Programme       @relation(fields: [programmeId], references: [id], onDelete: Restrict)
  department     Department      @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  faculty        Faculty         @relation(fields: [facultyId], references: [id], onDelete: Restrict)
  level          Level           @relation(fields: [levelId], references: [id], onDelete: Restrict)
  session        AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  semester       Semester        @relation(fields: [semesterId], references: [id], onDelete: Restrict)

  registrations CourseRegistration[]

  @@index([studentProfileId])
  @@index([programmeId])
  @@index([departmentId])
  @@index([facultyId])
  @@index([levelId])
  @@index([sessionId])
  @@index([semesterId])
}

model CourseRegistration {
  id               String                       @id @default(cuid())
  studentProfileId String
  sessionId        String
  semesterId       String
  enrollmentId     String
  status           String                       @default("DRAFT")
  totalCredits     Int                          @default(0)
  submittedAt      DateTime?
  approvedAt       DateTime?
  rejectedAt       DateTime?
  lockedAt         DateTime?
  createdByUserId  String?
  updatedByUserId  String?
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt
  hodApprovedAt    DateTime?
  deanApprovedAt   DateTime?
  approvals        RegistrationApprovalAction[]

  studentProfile StudentProfile             @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  session        AcademicSession            @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  semester       Semester                   @relation(fields: [semesterId], references: [id], onDelete: Restrict)
  enrollment     StudentProgrammeEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)

  items         CourseRegistrationItem[]
  resultEntries ResultEntry[]

  @@index([studentProfileId])
  @@index([sessionId])
  @@index([semesterId])
  @@index([enrollmentId])
  @@index([status])
}

model CourseRegistrationItem {
  id               String   @id @default(cuid())
  registrationId   String
  courseOfferingId String
  courseId         String
  creditUnits      Int
  itemType         String   @default("NORMAL")
  isCarryover      Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  registration   CourseRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  courseOffering CourseOffering     @relation(fields: [courseOfferingId], references: [id], onDelete: Restrict)
  course         Course             @relation(fields: [courseId], references: [id], onDelete: Restrict)

  @@index([registrationId])
  @@index([courseOfferingId])
  @@index([courseId])
}

model ResultSheet {
  id                            String    @id @default(cuid())
  courseOfferingId              String
  sessionId                     String
  semesterId                    String
  lecturerStaffProfileId        String
  status                        String    @default("DRAFT")
  numberOfStudents              Int       @default(0)
  numberRegisteredStudents      Int?
  submittedAt                   DateTime?
  approvedAt                    DateTime?
  publishedAt                   DateTime?
  rejectedAt                    DateTime?
  createdAt                     DateTime  @default(now())
  updatedAt                     DateTime  @updatedAt
  courseCoordinatorName         String?
  courseLecturerName            String?
  headOfDepartmentName          String?
  deanOfFacultyName             String?
  facultyExaminationOfficerName String?

  offering CourseOffering  @relation(fields: [courseOfferingId], references: [id], onDelete: Restrict)
  session  AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  semester Semester        @relation(fields: [semesterId], references: [id], onDelete: Restrict)
  lecturer StaffProfile    @relation(fields: [lecturerStaffProfileId], references: [id], onDelete: Restrict)

  entries                ResultEntry[]
  approvals              ResultApprovalAction[]
  gpaRecords             GPARecord[]
  ResultAmendmentRequest ResultAmendmentRequest[]

  @@index([courseOfferingId])
  @@index([sessionId])
  @@index([semesterId])
  @@index([lecturerStaffProfileId])
  @@index([status])
}

model ResultEntry {
  id                String   @id @default(cuid())
  resultSheetId     String
  studentProfileId  String
  registrationId    String?
  caScore           Float?
  examScore         Float?
  totalScore        Float?
  letterGrade       String?
  gradePoint        Float?
  remark            String?
  q1Score           Float?
  q2Score           Float?
  q3Score           Float?
  q4Score           Float?
  q5Score           Float?
  q6Score           Float?
  q7Score           Float?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  isPassed          Boolean?
  contributesToGPA  Boolean  @default(true)
  triggersCarryover Boolean  @default(false)

  resultSheet    ResultSheet         @relation(fields: [resultSheetId], references: [id], onDelete: Cascade)
  studentProfile StudentProfile      @relation(fields: [studentProfileId], references: [id], onDelete: Restrict)
  registration   CourseRegistration? @relation(fields: [registrationId], references: [id], onDelete: SetNull)

  transcriptEntries TranscriptLedgerEntry[]

  @@index([resultSheetId])
  @@index([studentProfileId])
  @@index([registrationId])
}

model ResultApprovalAction {
  id            String   @id @default(cuid())
  resultSheetId String
  actorUserId   String?
  actionType    String
  fromStatus    String?
  toStatus      String?
  comment       String?
  createdAt     DateTime @default(now())

  resultSheet ResultSheet @relation(fields: [resultSheetId], references: [id], onDelete: Cascade)

  @@index([resultSheetId])
  @@index([actorUserId])
}

model GPARecord {
  id                  String   @id @default(cuid())
  studentProfileId    String
  sessionId           String
  semesterId          String
  totalUnitsAttempted Int
  totalUnitsPassed    Int
  totalGradePoints    Float
  gpa                 Float
  calculatedAt        DateTime @default(now())
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  academicStanding    String?
  carryoverCount      Int      @default(0)

  studentProfile StudentProfile  @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  session        AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  semester       Semester        @relation(fields: [semesterId], references: [id], onDelete: Restrict)
  ResultSheet    ResultSheet?    @relation(fields: [resultSheetId], references: [id])
  resultSheetId  String?

  @@index([studentProfileId])
  @@index([sessionId])
  @@index([semesterId])
}

model CGPARecord {
  id                         String   @id @default(cuid())
  studentProfileId           String
  sessionId                  String
  semesterId                 String
  totalCumulativeUnits       Int
  totalCumulativeGradePoints Float
  cgpa                       Float
  calculatedAt               DateTime @default(now())
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
  cumulativeCarryoverCount   Int      @default(0)
  academicStanding           String?

  studentProfile StudentProfile  @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  session        AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  semester       Semester        @relation(fields: [semesterId], references: [id], onDelete: Restrict)

  @@index([studentProfileId])
  @@index([sessionId])
  @@index([semesterId])
}

model ResultAmendmentRequest {
  id                String    @id @default(cuid())
  resultSheetId     String
  requestedByUserId String?
  approvedByUserId  String?
  reason            String
  status            String    @default("PENDING")
  requestedAt       DateTime  @default(now())
  approvedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  resultSheet ResultSheet @relation(fields: [resultSheetId], references: [id], onDelete: Cascade)

  @@index([resultSheetId])
  @@index([requestedByUserId])
  @@index([approvedByUserId])
  @@index([status])
}

model RegistrationApprovalAction {
  id             String   @id @default(cuid())
  registrationId String
  actorUserId    String?
  actionType     String
  fromStatus     String?
  toStatus       String?
  comment        String?
  createdAt      DateTime @default(now())

  registration CourseRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@index([registrationId])
  @@index([actorUserId])
}

model TranscriptLedgerEntry {
  id               String   @id @default(cuid())
  studentProfileId String
  sessionId        String
  semesterId       String
  courseId         String
  resultEntryId    String?
  courseCode       String
  courseTitle      String
  creditUnits      Int
  totalScore       Float?
  letterGrade      String?
  gradePoint       Float?
  remark           String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  studentProfile StudentProfile  @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  session        AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  semester       Semester        @relation(fields: [semesterId], references: [id], onDelete: Restrict)
  course         Course          @relation(fields: [courseId], references: [id], onDelete: Restrict)
  resultEntry    ResultEntry?    @relation(fields: [resultEntryId], references: [id], onDelete: SetNull)

  @@index([studentProfileId])
  @@index([sessionId])
  @@index([semesterId])
  @@index([courseId])
  @@index([resultEntryId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

model StudentFinanceAccount {
  id                   String   @id @default(cuid())
  studentProfileId     String   @unique
  currentSessionId     String?
  currentSemesterId    String?
  tuitionAmountDue     Float    @default(0)
  otherChargesDue      Float    @default(0)
  totalAmountDue       Float    @default(0)
  totalAmountPaid      Float    @default(0)
  outstandingBalance   Float    @default(0)
  isFinanciallyCleared Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  studentProfile  StudentProfile   @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  currentSession  AcademicSession? @relation(fields: [currentSessionId], references: [id], onDelete: SetNull)
  currentSemester Semester?        @relation(fields: [currentSemesterId], references: [id], onDelete: SetNull)

  paymentTransactions  PaymentTransaction[]
  financeHolds         FinanceHold[]
  financeOverrides     FinanceOverrideRequest[]
  receiptLedgerEntries ReceiptLedgerEntry[]

  @@index([currentSessionId])
  @@index([currentSemesterId])
  @@index([isFinanciallyCleared])
}

model PaymentTransaction {
  id                      String    @id @default(cuid())
  studentFinanceAccountId String
  studentProfileId        String
  reference               String    @unique
  paymentChannel          String
  paymentSource           String?
  paymentDate             DateTime
  amount                  Float
  currency                String    @default("NGN")
  paymentStatus           String    @default("PENDING")
  verificationStatus      String    @default("UNVERIFIED")
  externalTransactionId   String?
  sessionId               String?
  semesterId              String?
  narration               String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  verificationCheckedAt   DateTime?
  verifiedByUserId        String?
  verificationMessage     String?

  financeAccount StudentFinanceAccount @relation(fields: [studentFinanceAccountId], references: [id], onDelete: Cascade)
  studentProfile StudentProfile        @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  session        AcademicSession?      @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  semester       Semester?             @relation(fields: [semesterId], references: [id], onDelete: SetNull)

  receiptLedgerEntries ReceiptLedgerEntry[]

  @@index([studentFinanceAccountId])
  @@index([studentProfileId])
  @@index([paymentStatus])
  @@index([verificationStatus])
  @@index([sessionId])
  @@index([semesterId])
}

model ReceiptLedgerEntry {
  id                      String   @id @default(cuid())
  studentFinanceAccountId String
  studentProfileId        String
  paymentTransactionId    String?
  receiptNumber           String   @unique
  receiptDate             DateTime
  amount                  Float
  description             String
  sessionId               String?
  semesterId              String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  financeAccount     StudentFinanceAccount @relation(fields: [studentFinanceAccountId], references: [id], onDelete: Cascade)
  studentProfile     StudentProfile        @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  paymentTransaction PaymentTransaction?   @relation(fields: [paymentTransactionId], references: [id], onDelete: SetNull)
  session            AcademicSession?      @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  semester           Semester?             @relation(fields: [semesterId], references: [id], onDelete: SetNull)

  @@index([studentFinanceAccountId])
  @@index([studentProfileId])
  @@index([paymentTransactionId])
  @@index([sessionId])
  @@index([semesterId])
}

model FinanceHold {
  id                      String    @id @default(cuid())
  studentFinanceAccountId String
  studentProfileId        String
  holdType                String
  reason                  String
  isActive                Boolean   @default(true)
  placedByUserId          String?
  releasedByUserId        String?
  placedAt                DateTime  @default(now())
  releasedAt              DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  financeAccount StudentFinanceAccount @relation(fields: [studentFinanceAccountId], references: [id], onDelete: Cascade)
  studentProfile StudentProfile        @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@index([studentFinanceAccountId])
  @@index([studentProfileId])
  @@index([isActive])
}

model FinanceOverrideRequest {
  id                      String    @id @default(cuid())
  studentFinanceAccountId String
  studentProfileId        String
  requestedByUserId       String?
  approvedByUserId        String?
  requestType             String
  reason                  String
  status                  String    @default("PENDING")
  approvedAt              DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  financeAccount StudentFinanceAccount @relation(fields: [studentFinanceAccountId], references: [id], onDelete: Cascade)
  studentProfile StudentProfile        @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@index([studentFinanceAccountId])
  @@index([studentProfileId])
  @@index([status])
}

model InstallmentPlan {
  id                        String    @id @default(cuid())
  studentProfileId          String
  sessionId                 String
  semesterId                String
  approvedByUserId          String?
  totalAmountDue            Float
  minimumRequiredToRegister Float
  approvedAt                DateTime?
  isActive                  Boolean   @default(true)
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  studentProfile StudentProfile  @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  session        AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  semester       Semester        @relation(fields: [semesterId], references: [id], onDelete: Restrict)

  @@index([studentProfileId])
  @@index([sessionId])
  @@index([semesterId])
  @@index([isActive])
}
